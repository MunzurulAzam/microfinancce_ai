# Copy to .env and fill in. Never commit .env — it is gitignored.

# ── DW data warehouse ────────────────────────────────────────────────────────
# One MSSQL catalog holding all 4 countries (UG/KY/ZM/TZ); every table carries
# CountryId + CountryCode. This is what ask_ai queries.
DW_SERVER=
DW_PORT=64928
DW_USER=
DW_PASSWORD=
DW_DATABASE=DW

# ── Legacy per-country MSSQL (credit_scoring, portfolio) ─────────────────────
MSSQL_SERVER=
MSSQL_PORT=1543
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_DATABASE=db_UMISv2_ug

# ── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
ASK_AI_MODEL=qwen2.5:7b-instruct
OLLAMA_VISION_MODEL=minimax-m3:cloud

# ── ask_ai tuning (all optional, defaults in ask_ai/config.py) ───────────────
# ASK_AI_POOL_SIZE=5
# ASK_AI_QUERY_TIMEOUT=60
# ASK_AI_MAX_ROWS=1000
# ASK_AI_RESULT_TTL=300

SECRET_KEY=
