# Copy to .env and fill in. Never commit .env — it is gitignored.

# ── DW data warehouse ────────────────────────────────────────────────────────
# One MSSQL catalog holding all 4 countries (UG/KY/ZM/TZ); every table carries
# CountryId + CountryCode. This is what ask_ai queries.
DW_SERVER=
DW_PORT=64928
DW_USER=
DW_PASSWORD=
DW_DATABASE=DW

# ── Legacy per-country MSSQL (credit_scoring, portfolio) ─────────────────────
MSSQL_SERVER=
MSSQL_PORT=1543
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_DATABASE=db_UMISv2_ug

# Cloud inference only. Server-side credentials; never put these in VITE_* settings.
# Signed-in local Ollama forwards cloud requests; no Python API key required.
OLLAMA_TRANSPORT=local_cloud
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional, only for OLLAMA_TRANSPORT=direct_cloud
OLLAMA_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com
ASK_AI_MODEL=gpt-oss:120b-cloud
OLLAMA_MODEL=gpt-oss:120b-cloud
REPORT_AI_MODEL=gpt-oss:120b-cloud
OLLAMA_VISION_MODEL=gemma4:31b-cloud
# Free Ollama model tried when the primary is busy or out of quota; empty disables it.
OLLAMA_FALLBACK_MODEL=nemotron-3-super:cloud
# Optional free Groq fallback for text/SQL only (never images): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional verified FX JSON file; see docs/report-api.md.
# REPORT_FX_FILE=/absolute/path/monthly-fx.json
# REPORT_STORAGE_DIR=/persistent/path/reports

# ── ask_ai tuning (all optional, defaults in ask_ai/config.py) ───────────────
# ASK_AI_POOL_SIZE=5
# ASK_AI_QUERY_TIMEOUT=60
# ASK_AI_MAX_ROWS=1000
# ASK_AI_RESULT_TTL=300

# ── Dify external knowledge API ──────────────────────────────────────────────
# Shared secret Dify sends as `Authorization: Bearer <key>`. Empty = endpoint closed.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
DIFY_KB_API_KEY=
# DIFY_MAX_TOP_K=10
# DIFY_TABLE_ROWS=50

SECRET_KEY=
